# ─────────────────────────────────────────────────────────────
# IIT Tunnel Hub — configuración
# Copie este archivo a .env y ajuste los valores marcados con ⚠
# Lo leen tanto el hub (API/panel) como frps.
# ─────────────────────────────────────────────────────────────

# ⚠ Token para entrar al panel y a la API (mínimo 16 caracteres)
#   Generar:  openssl rand -base64 32
ADMIN_TOKEN=CAMBIAR_POR_UN_TOKEN_LARGO
# El ADMIN_TOKEN sirve para la API y para crear el primer administrador en el panel; las personas entran con usuario.
# COOKIE_SECURE=1 exige HTTPS para la cookie de sesión (se activa sola detrás de un proxy con X-Forwarded-Proto: https)
COOKIE_SECURE=0

# Respaldos de hub.db (diarios; hora y retención se ajustan en el panel → Estado)
# BACKUP_DIR=/data/respaldos            por defecto: carpeta "respaldos" junto a hub.db
# BACKUP_KEY=una-frase-larga-y-secreta  si se define, los respaldos se cifran (AES-256-GCM); guárdela fuera del servidor

# SNMP: el hub usa su propio frpc (visitante interno) para consultar equipos de las sedes por túneles privados
# HUB_FRPC_PATH=/usr/local/bin/frpc     por defecto lo busca en frp/, /usr/local/bin o el PATH
# HUB_FRPC_ADMIN_PORT=7401              API local de ese frpc (solo 127.0.0.1)
# SNMP_PORT_BASE=16200                  puertos UDP locales (127.0.0.1) que abre, uno por equipo

# Panel y API. 127.0.0.1 = solo accesible desde el propio servidor (SSH -L 8080:127.0.0.1:8080)
# Use la IP de ZeroTier/LAN para abrirlo en su red privada. No lo publique en Internet sin HTTPS.
HOST=127.0.0.1
PORT=8080

# Endpoint interno que consulta frps. No cambie el host.
PLUGIN_HOST=127.0.0.1
PLUGIN_PORT=9000

# ⚠ Dirección con la que las máquinas llegan a frps: dominio, IP pública, o IP de ZeroTier/LAN
FRPS_PUBLIC_ADDR=tuneles.infraestructura-it.com
FRPS_BIND_PORT=7000

# ⚠ Dominio base de los servicios web: <servicio>-<maquina>.clientes.infraestructura-it.com
#   Requiere un registro DNS comodín *.clientes.infraestructura-it.com → IP del servidor
FRPS_SUBDOMAIN_HOST=clientes.infraestructura-it.com
FRPS_VHOST_HTTP_PORT=80
FRPS_VHOST_HTTPS_PORT=443
# Solo si frps queda detrás de otro proxy (Nginx en el 443): puertos que ven los visitantes
# PUBLIC_HTTP_PORT=80
# PUBLIC_HTTPS_PORT=443

# Rango de puertos públicos para servicios TCP (SSH, RDP, Modbus TCP…). Ábralo en el firewall.
FRPS_TCP_PORT_MIN=20000
FRPS_TCP_PORT_MAX=20100

# Token global de frps (opcional). La autorización real es por máquina; puede dejarse vacío.
FRP_AUTH_TOKEN=

# ⚠ Contraseña del dashboard interno de frps (solo escucha en 127.0.0.1:7500)
FRPS_API_URL=http://127.0.0.1:7500
FRPS_API_USER=admin
FRPS_API_PASSWORD=CAMBIAR_POR_OTRA_CLAVE

# Alertas: cada cuánto se revisa el estado de las máquinas y zona horaria de los mensajes.
# Los canales (Telegram, webhooks) y el tiempo de gracia se configuran desde el panel → 🔔 Alertas.
ALERT_CHECK_SECONDS=15
TZ_ALERTS=America/Bogota

# IA (Claude API). La clave y el modelo también se pueden configurar desde el panel → 🤖 IA → Ajustes;
# si se define aquí, tiene prioridad y no se puede cambiar desde el panel.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5-5
# Clave SSH con la que el hub ejecuta comandos (se crea sola junto a la base de datos)
# AI_SSH_KEY=/data/ia_ssh_ed25519
